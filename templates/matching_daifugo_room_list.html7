<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>大富豪：部屋一覧</title>
<script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
<style>
body { font-family: sans-serif; }
.room-box {
    border: 1px solid #ccc;
    padding: 10px;
    margin: 8px 0;
}
</style>
</head>

<body>

<h1>大富豪：部屋一覧</h1>

<div id="room_list"></div>

<script>
const socket = io();

// ★ 接続完了後に部屋一覧を要求
socket.on("connect", () => {
    socket.emit("request_room_list");
});

// ★ サーバーから部屋一覧を受信
socket.on("daifugo_room_list", rooms => {
    const list = document.getElementById("room_list");
    list.innerHTML = "";

    if (!rooms || rooms.length === 0) {
        list.innerHTML = "<p>現在開いている部屋はありません。</p>";
        return;
    }

    rooms.forEach(room => {
        const div = document.createElement("div");
        div.className = "room-box";

        const players = room.players.map(p => `<li>${p}</li>`).join("");

        div.innerHTML = `
            <p><strong>部屋ID：</strong> ${room.room_id}</p>
            <p>参加者：</p>
            <ul>${players}</ul>
            <button onclick="joinRoom('${room.room_id}')">この部屋に参加する</button>
        `;

        list.appendChild(div);
    });
});

// ★ 部屋参加処理
function joinRoom(room_id) {
    window.location.href = `/matching_daifugo_room_join?room_id=${room_id}`;
}
</script>

</body>
</html>

